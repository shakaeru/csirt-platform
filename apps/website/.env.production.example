# Template .env PRODUCTION website (csirt.pcr.ac.id). Di VPS disalin ke /opt/csirt/apps/website/.env
# (owner deploy, mode 600) — README.md § Deploy. JANGAN commit .env berisi nilai asli.
# Dibaca docker compose (env_file), bukan Laravel langsung: jangan pakai interpolasi ${...}.
# Config di-cache saat container start — setelah mengubah file ini: docker compose up -d --force-recreate.

APP_NAME="UKM CSIRT PCR"
APP_ENV=production
# Isi dengan: docker compose run --rm --no-deps website php artisan key:generate --show
# Mengganti APP_KEY memutus semua sesi login dan mengubah URL upload Livewire.
APP_KEY=
APP_DEBUG=false
APP_URL=https://csirt.pcr.ac.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log ke stderr → `docker compose logs website`
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite di volume `database` (docker-compose.yml). WAL + busy_timeout: pembaca tidak terblokir
# saat ada penulisan (sesi, cache) dan penulisan bersamaan menunggu, bukan langsung "database is locked".
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/sqlite/database.sqlite
DB_JOURNAL_MODE=wal
DB_BUSY_TIMEOUT=5000
DB_SYNCHRONOUS=normal
# DB_PERSISTENT (koneksi persisten) diatur di docker-compose.yml, bukan di sini.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie sesi hanya lewat HTTPS (TLS berakhir di Nginx edge; Laravel tahu lewat X-Forwarded-Proto).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Belum ada queue worker — job dijalankan langsung, bukan menumpuk di tabel jobs.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Email belum dikonfigurasi (formulir Kontak menyusul): email hanya ditulis ke log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@csirt.pcr.ac.id"
MAIL_FROM_NAME="UKM CSIRT PCR"

# Email yang boleh dijadikan Super Admin lewat SSH, dipisah koma (GUIDELINES § 7). Akses panel
# ditentukan role; akun lain dibuat dari panel (Akses → Pengguna).
# Super Admin: docker compose exec website php artisan admin:create <email>
ADMIN_EMAILS=

DISPLAY_TIMEZONE=Asia/Jakarta
